# Copy this file to .env and set the token below (the compose files read it from the environment).

# Bearer token of the backend's /api routes. Set it before the first `up`: generate one with `openssl rand -hex 32`.
# Left empty, the backend refuses every /api request (an empty expected token fails closed).
BACKEND_REFRESH_TOKEN=

# Backend workers: 1. The GPU pipeline slot is a per-process semaphore (one GPU, one slot):
# the backend refuses to start with more than one worker.
UVICORN_WORKERS=1
