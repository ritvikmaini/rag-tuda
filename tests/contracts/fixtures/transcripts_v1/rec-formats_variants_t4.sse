data: {"type": "citations", "content": [{"n": 1, "url": "https://www.informatik.tu-darmstadt.de/studium_fb20/im_studium/formulare_und_dokumente/ordnungen/ordnungen_bsc_informatik.de.jsp#pruefungsordnung_2015", "page": null, "title": "Ordnungen zum Bachelor of Science Informatik \u2013 Pr\u00fcfungsordnung 2015", "type": "Pr\u00fcfungsordnung", "origin": "Fachbereich Informatik, TU Darmstadt", "date": "2015", "quote": "Pr\u00fcfungsordnung 2015 Wer vor dem Wintersemester 2023/24 begonnen hat, studiert weiter nach der Ordnung von 2015. Die Regelstudienzeit betr\u00e4gt sechs Semester, die Bachelor-Thesis wird in vier Monaten\u2026"}, {"n": 2, "url": "https://www.informatik.tu-darmstadt.de/media/informatik/fb20_studium/formulare_und_dokumente/ordnungen/ordnungen_bsc/pruefungsordnung_2023/Studiengangsordnung_Bachelor_Informatik_2023.pdf", "page": 2, "title": "Studiengangsordnung Bachelor Informatik 2023", "type": "Pr\u00fcfungsordnung", "origin": "Fachbereich Informatik, TU Darmstadt", "date": "2023", "quote": "\u00a7 4 Module und Pr\u00fcfungen Jedes Modul schlie\u00dft mit einer Pr\u00fcfungsleistung ab. Die Art der Pr\u00fcfung gibt das Modulhandbuch zu Semesterbeginn bekannt. Nicht bestandene Pr\u00fcfungen werden nach \u00a7 22 APB\u2026"}]}

